+// Private research ownership registry: not a shipped API.
+static RESEARCH_WATCHERS: std::sync::OnceLock<std::sync::Mutex<Vec<tokio::task::JoinHandle<Changes>>>> = std::sync::OnceLock::new();
+pub fn research_defer(snapshot: Snapshot) {
+    RESEARCH_WATCHERS.get_or_init(Default::default).lock().unwrap().push(tokio::spawn(snapshot.detect_async()));
+}
+pub async fn research_drain() -> Result<Vec<Changes>, tokio::task::JoinError> {
+    let tasks = std::mem::take(&mut *RESEARCH_WATCHERS.get_or_init(Default::default).lock().unwrap());
+    let mut changes = Vec::new();
+    for task in tasks { changes.push(task.await?); }
+    Ok(changes)
+}

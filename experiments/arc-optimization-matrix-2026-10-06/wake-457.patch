+// Notifications are wake hints only. A missing notification still falls back
+// to the full periodic observation horizon; it never proves unchanged state.
+#[derive(Default)]
+struct ActivationWake {
+    generation: Mutex<u64>,
+    changed: Condvar,
+}
+
+impl ActivationWake {
+    fn current(&self) -> u64 {
+        *self.generation.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    fn notify(&self) {
+        let mut generation = self.generation.lock().unwrap_or_else(|e| e.into_inner());
+        *generation = generation.wrapping_add(1);
+        self.changed.notify_all();
+    }
+
+    fn wait(&self, seen: &mut u64, duration: Duration) {
+        let generation = self.generation.lock().unwrap_or_else(|e| e.into_inner());
+        let (generation, _) = self.changed
+            .wait_timeout_while(generation, duration, |generation| *generation == *seen)
+            .unwrap_or_else(|e| e.into_inner());
+        if *seen != *generation {
+            tracing::debug!("window observation woke after activation hint");
+        }
+        *seen = *generation;
+    }
+}
+
+fn activation_wake() -> &'static ActivationWake {
+    static WAKE: OnceLock<ActivationWake> = OnceLock::new();
+    WAKE.get_or_init(ActivationWake::default)
+}
+
+pub(crate) fn wake_after_activation() {
+    tracing::debug!("activation hint received after restore requests");
+    activation_wake().notify();
+}
